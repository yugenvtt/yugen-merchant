<section class="shop-content">
	<div class="tab {{tabs.buy.cssClass}}" data-tab="buy" data-group="shop">
		<ol class="shop-list">
			{{#each buy_items}}
			<li class="shop-item" data-item-index="{{this.index}}">
				<img class="item-img" src="{{this.img}}" />
				<div class="item-name">
					{{this.name}} <span class="qty-badge">(x{{this.quantity}})</span>
					{{#if this.heavy}}
					<i class="fas fa-weight-hanging heavy-warning" title="Warning: This item may encumber you!"></i>
					{{/if}}
				</div>
				<div class="item-price">{{this.price}} {{this.denom}}</div>
				<div class="controls">
					<button type="button" class="info-btn" data-action="show-sheet" title="View Item Details">
						<i class="fas fa-circle-info"></i>
					</button>
					<button type="button" data-action="buy">Buy</button>
				</div>
			</li>
			{{else}}
			<p class="empty-msg">The merchant has no items for sale.</p>
			{{/each}}
		</ol>
	</div>

	<div class="tab {{tabs.sell.cssClass}}" data-tab="sell" data-group="shop">
		<ol class="shop-list">
			{{#each sell_items}}
			<li class="shop-item" data-item-id="{{this.id}}">
				<img class="item-img" src="{{this.img}}" />
				<div class="item-name">
					{{this.name}} <span class="qty-badge">(x{{this.quantity}})</span>
				</div>
				<div class="item-price">{{this.price}} {{this.denom}}</div>
				<div class="controls">
					<button type="button" class="info-btn" data-action="show-sheet" title="View Item Details">
						<i class="fas fa-circle-info"></i>
					</button>
					<button type="button" data-action="sell">Sell</button>
				</div>
			</li>
			{{else}}
			<p class="empty-msg">You have no items to sell.</p>
			{{/each}}
		</ol>
	</div>

	{{#if can_manage}}
	<div class="tab {{tabs.manage.cssClass}}" data-tab="manage" data-group="shop">
		<div class="yugen-merchant-config">
			<fieldset class="config-group">
				<legend><i class="fas fa-toggle-on"></i> {{localize 'yugen-merchant.config.merchant-status.name'}}</legend>
				
				<div class="settings-grid">
					<div class="form-group flexrow">
						<label>Enable Merchant Mode</label>
						<div class="form-fields">
							<input type="checkbox" data-action="toggle-merchant" class="merchant-toggle" {{#if merchant.is_merchant}}checked{{/if}}>
						</div>
					</div>

					<div class="form-group flexrow">
						<label>{{localize 'yugen-merchant.config.merchant-status.infinite-funds'}}</label>
						<div class="form-fields">
							<input type="checkbox" data-action="toggle-infinite" class="infinite-funds-toggle" {{#if merchant.is_infinite}}checked{{/if}} {{#unless is_gm}}disabled{{/unless}}>
						</div>
					</div>

					<div class="form-group flexrow">
						<label>{{localize 'yugen-merchant.config.merchant-status.allow-owner'}}</label>
						<div class="form-fields">
							<input type="checkbox" data-action="toggle-owner-manage" class="owner-manage-toggle" {{#if merchant.allow_owner_manage}}checked{{/if}} {{#unless is_gm}}disabled{{/unless}}>
						</div>
					</div>
				</div>
				<p class="hint">{{localize 'yugen-merchant.config.merchant-status.hint'}}</p>
			</fieldset>

			<fieldset class="greeting-group">
				<legend><i class="fas fa-comment-dots"></i> {{localize 'yugen-merchant.config.merchant-status.greeting-message'}}</legend>
				<div class="form-group stacked">
					<div class="form-fields">
						<input type="text" data-action="update-greeting" class="greeting-message" value="{{merchant.greeting}}" placeholder="Greetings, traveler...">
					</div>
					<p class="hint">{{localize 'yugen-merchant.config.merchant-status.greeting-hint'}}</p>
				</div>
			</fieldset>

			<fieldset class="discount-group">
				<legend>{{localize 'yugen-merchant.config.merchant-discounts.name'}}</legend>
				<div class="form-group">
					<label>{{localize 'yugen-merchant.config.merchant-discounts.buy-discount'}}</label>
					<div class="form-fields">
						<input type="number" data-action="update-multiplier" class="buy-multiplier" value="{{buy_multiplier}}" min="0" step="1">
					</div>
					<p class="hint">{{localize 'yugen-merchant.config.merchant-discounts.buy-hint'}}</p>
				</div>

				<div class="form-group">
					<label>{{localize 'yugen-merchant.config.merchant-discounts.sell-discount'}}</label>
					<div class="form-fields">
						<input type="number" data-action="update-multiplier" class="sell-multiplier" value="{{sell_multiplier}}" min="0" step="1">
					</div>
					<p class="hint">{{localize 'yugen-merchant.config.merchant-discounts.sell-hint'}}</p>
				</div>
			</fieldset>

			<fieldset class="rarity-group">
				<legend>{{localize 'yugen-merchant.config.rarity-multipliers.name'}}</legend>
				<p class="hint">{{localize 'yugen-merchant.config.rarity-multipliers.hint'}}</p>
				
				<div class="rarity-grid">
					{{#each rarity_multipliers}}
					<div class="rarity-item">
						<label>{{localize (concat 'yugen-merchant.config.rarity-multipliers.' @key)}}</label>
						<div class="form-fields">
							<input type="number" data-action="update-multiplier" class="rarity-multiplier" data-rarity="{{@key}}" value="{{this}}" min="0" step="1">
							<span class="unit">%</span>
						</div>
					</div>
					{{/each}}
				</div>

				<button type="button" data-action="randomize-rarities">
					<i class="fas fa-dice"></i> {{localize 'yugen-merchant.config.rarity-multipliers.randomize'}}
				</button>
			</fieldset>

			<fieldset class="inventory-group">
				<legend><i class="fas fa-boxes"></i> {{localize 'yugen-merchant.config.virtual-inventory.name'}}</legend>
				
				<div class="inventory-table">
					<ol class="inventory-list">
						{{#each inventory}}
						<li class="inventory-item" data-index="{{@index}}">
							<div class="item-name">
								<div class="item-image">
									{{#if this.img}}
										<img src="{{this.img}}" alt="{{this.name}}" onerror="this.style.display='none'">
									{{else}}
										<i class="fas fa-box"></i>
									{{/if}}
								</div>
								<span class="name-text">{{this.name}}</span>
								<span class="qty-badge">(x{{this.system.quantity}})</span>
							</div>
							
							<div class="item-controls">
								<button type="button" data-action="edit-item" class="edit-item control-button" title="Edit Item Details">
									<i class="fa-solid fa-pen-to-square"></i>
								</button>
								<button type="button" data-action="delete-item" class="delete-item control-button" title="Remove Item">
									<i class="fa-solid fa-trash"></i>
								</button>
							</div>
						</li>
						{{else}}
						<li class="empty-inventory">
							<p class="hint">{{localize 'yugen-merchant.config.virtual-inventory.empty-hint'}}</p>
						</li>
						{{/each}}
					</ol>
				</div>
				<p class="hint">Drag and drop items here to add them to the merchant's virtual inventory.</p>
			</fieldset>
		</div>
	</div>
	{{/if}}
</section>
